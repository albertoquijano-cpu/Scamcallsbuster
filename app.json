{
  "expo": {
    "name": "ScamCalls Buster",
    "slug": "scamcallsbuster",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Necesario para filtrar llamadas de números desconocidos"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "infoPlist": {
              "NSMicrophoneUsageDescription": "Para escuchar al emisor durante el filtro de llamadas"
            }
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.albertoquijano.scamcallsbuster",
      "infoPlist": {
        "UIBackgroundModes": [
          "voip",
          "audio",
          "voip",
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.albertoquijano.scamcallsbuster",
      "permissions": [
        "READ_PHONE_STATE",
        "ANSWER_PHONE_CALLS",
        "READ_CONTACTS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "705336ea-3c58-459b-9b55-ced7d9e2890e"
      }
    }
  }
}
